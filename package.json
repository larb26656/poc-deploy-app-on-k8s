{
  "name": "catalog-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:catalog": "pnpm --filter catalog-service... build",
    "build:availability": "pnpm --filter availability-service... build",
    "dev:catalog": "pnpm --filter catalog-service start:dev",
    "dev:availability": "pnpm --filter availability-service start:dev",
    "up": "docker compose up --build -d",
    "logs": "docker compose logs -f",
    "down": "docker compose down",
    "k8s:apply": "kubectl apply -f deployment/",
    "k8s:delete": "kubectl delete -f deployment/",
    "k8s:all": "pnpm deploy:traefik && pnpm k8s:apply",
    "deploy:traefik": "helm dependency build deployment/traefik && helm upgrade --install traefik deployment/traefik -n traefik-system --create-namespace"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
